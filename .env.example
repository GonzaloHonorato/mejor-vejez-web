# Copiar a `.env` (NO se versiona). En Dokploy van en la pestaña Environment.

# URL pública de la API, sin barra final.
API_URL=https://mejor-vejez-api.adndigital.cl

# Firebase (consola → Configuración del proyecto → Tus apps → SDK). No son secretas.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
